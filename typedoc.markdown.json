{
  "$schema": "https://typedoc.org/schema.json",
  "cleanOutputDir": true,
  "disableGit": true,
  "disableSources": true,
  "entryPoints": [
    "packages/app/src/index.ts",
    "packages/cli/src/index.ts",
    "packages/csv/src/index.ts",
    "packages/yaml/src/index.ts"
  ],
  "includeVersion": true,
  "name": "s20",
  "out": "docs/markdown",
  "plugin": ["typedoc-plugin-markdown"],
  "readme": "README.md"
}
