{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["bun"],
    "paths": {
      "@s20/app": ["./packages/app/src/index.ts"],
      "@s20/cli": ["./packages/cli/src/index.ts"],
      "@s20/csv": ["./packages/csv/src/index.ts"],
      "@s20/yaml": ["./packages/yaml/src/index.ts"]
    }
  },
  "include": ["packages/*/src/**/*", "bin/**/*", "packages/*/test/**/*"],
  "exclude": ["node_modules", "**/dist"]
}
