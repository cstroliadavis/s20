{
  "name": "s20",
  "version": "0.1.0",
  "description": "Spouse 2.0 (S20) CLI time tracking tool",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "bin": {
    "s20": "./bin/s20.ts"
  },
  "main": "./packages/core/src/index.ts",
  "module": "./packages/core/src/index.ts",
  "types": "./packages/core/src/index.ts",
  "scripts": {
    "docs": "typedoc --options typedoc.json && typedoc --options typedoc.markdown.json",
    "docs:html": "typedoc --options typedoc.json",
    "docs:markdown": "typedoc --options typedoc.markdown.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "start": "bun run ./bin/s20.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "time-tracking",
    "cli",
    "bun",
    "csv"
  ],
  "license": "MIT",
  "dependencies": {
    "@s20/cli": "workspace:*",
    "@s20/core": "workspace:*",
    "@s20/csv": "workspace:*",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/bun": "latest",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "temporal-spec": "^1.0.1",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.1",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.71.0"
  }
}
