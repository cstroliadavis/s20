{
  "name": "s20",
  "version": "0.1.0",
  "description": "Spouse 2.0 (S20) CLI time tracking tool",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "bin": {
    "s20": "./bin/s20.ts"
  },
  "main": "./packages/app/src/index.ts",
  "module": "./packages/app/src/index.ts",
  "types": "./packages/app/src/index.ts",
  "scripts": {
    "docs": "typedoc --options typedoc.json && typedoc --options typedoc.markdown.json",
    "docs:html": "typedoc --options typedoc.json",
    "docs:markdown": "typedoc --options typedoc.markdown.json",
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "lint": "bun lint",
    "lint:fix": "bun lint --fix",
    "start": "bun run ./bin/s20.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "typecheck": "bun check"
  },
  "keywords": [
    "time-tracking",
    "cli",
    "bun",
    "csv"
  ],
  "license": "MIT",
  "dependencies": {
    "@s20/app": "workspace:*",
    "@s20/cli": "workspace:*",
    "@s20/csv": "workspace:*",
    "@s20/logging": "workspace:*",
    "@s20/storage": "workspace:*",
    "@s20/yaml": "workspace:*"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/bun": "latest",
    "eslint": "^10.11.0",
    "eslint-plugin-jsdoc": "^62.9.0",
    "temporal-spec": "^1.0.1",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.1",
    "typescript": "^5.9.3"
  }
}
