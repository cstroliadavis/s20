{
  "name": "s20",
  "version": "0.1.0",
  "description": "Spouse 2.0 (S20) CLI time tracking tool",
  "type": "module",
  "bin": {
    "s20": "./bin/s20.ts"
  },
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "start": "bun run ./bin/s20.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "time-tracking",
    "cli",
    "bun",
    "csv"
  ],
  "license": "MIT",
  "dependencies": {
    "coliner": "file:../coliner",
    "csv-lib": "file:../csv-lib"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/bun": "latest",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.71.0"
  }
}
