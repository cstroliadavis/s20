{
  "$schema": "https://typedoc.org/schema.json",
  "cleanOutputDir": true,
  "disableGit": true,
  "disableSources": true,
  "entryPoints": [
    "packages/core/src/index.ts",
    "packages/cli/src/index.ts",
    "packages/csv/src/index.ts"
  ],
  "highlightLanguages": [
    "bash",
    "css",
    "fish",
    "html",
    "javascript",
    "json",
    "sh",
    "typescript",
    "yaml",
    "zsh"
  ],
  "includeVersion": true,
  "name": "s20",
  "out": "docs",
  "readme": "README.md"
}
